# Copiar a .env (no se versiona). Sin secretos reales aquí.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Rol de aplicación (sujeto a RLS). Su contraseña la fija `npm run db:migrate`.
DATABASE_URL=postgres://turnoextra_app:CAMBIAR_app_pw@localhost:5432/turnoextra
# Rol dueño del esquema, solo para migrar.
MIGRATION_DATABASE_URL=postgres://turnoextra_owner:owner_dev_only@localhost:5432/turnoextra
APP_DB_PASSWORD=CAMBIAR_app_pw

SENTRY_DSN=
# H1+: BETTER_AUTH_SECRET=
# H3+: WHATSAPP_TOKEN= WHATSAPP_APP_SECRET= TELEGRAM_BOT_TOKEN=

# H1: autenticación y correo
BETTER_AUTH_SECRET=CAMBIAR_por_un_secreto_largo_de_32_caracteres_o_mas
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:5173
# Sin SMTP_URL los correos se escriben en el log (solo desarrollo).
# Resend: smtps://resend:<API_KEY>@smtp.resend.com:465 · EMAIL_FROM de un dominio verificado en Resend.
SMTP_URL=
EMAIL_FROM=TurnoExtra <no-reply@localhost>

# WhatsApp Cloud API (número de prueba de Meta). Déjalo vacío para no enviar por WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# false = apaga el envío por WhatsApp (Telegram y correo siguen).
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v21.0
# Simulador /demo (plan B), solo super admin
DEMO_MODE=false
POLICY_URL=
WHATSAPP_PUBLIC_NUMBER=
# H4: Telegram (bot creado con @BotFather) y correo del candidato (usa SMTP_URL / EMAIL_FROM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# true = el worker lee Telegram por sondeo (getUpdates), útil sin URL pública. En producción: false + webhook.
TELEGRAM_POLLING=false

# Documentación interactiva en /docs (Swagger UI). Por defecto solo fuera de producción.
DOCS_ENABLED=

# Solo pruebas: guarda los documentos en la carpeta temporal del sistema (MOCK_STORAGE_DIR la cambia) en vez del bucket de Neon (opt-in explícito; en Render el disco es efímero). Con bucket real configurado, el bucket manda.
MOCK_STORAGE=false
